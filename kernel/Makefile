obj-m := jprof.o
ccflags-y := -I$(src)

KDIR ?= /lib/modules/$(shell uname -r)/build

all:
	$(MAKE) -C $(KDIR) M=$(CURDIR) modules
	@# Ship a lean module: drop debug info, and drop the split-BTF section
	@# (it is only used by BPF tooling, and BTF generated by a different
	@# pahole than the running kernel's cannot be matched to it anyway).
	strip --strip-debug jprof.ko
	objcopy --remove-section=.BTF jprof.ko

clean:
	$(MAKE) -C $(KDIR) M=$(CURDIR) clean
